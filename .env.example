# ---------------------------------------------------------------------------
# Hilal — ortam değişkenleri
# Supabase değişkenleri boşsa uygulama SENTETİK verilerle "demo modunda" çalışır.
# Production'da demo modu yalnızca ALLOW_DEMO_MODE=true ile açılır (önerilmez).
# ---------------------------------------------------------------------------

# Sitenin kanonik adresi (canonical, sitemap, OG). https ile başlıyorsa CSP upgrade-insecure-requests eklenir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucuda kullanılır; asla istemciye/NEXT_PUBLIC_ önekine taşımayın.
SUPABASE_SERVICE_ROLE_KEY=

# IP adreslerini tuzlu özetlemek için (en az 32 karakter). Production'da ZORUNLU. Üretmek: openssl rand -hex 32
IP_HASH_SALT=

# Kendi sunucunuzda (Vercel dışı) istemci IP'sini taşıyan güvenilir başlık, ör. cf-connecting-ip.
# Tanımsızsa: Vercel'de platform başlıkları; diğer ortamlarda X-Forwarded-For zincirinin SON değeri.
# Uygulamayı doğrudan internete açmayın — başlığı ezen bir ters vekil (nginx vb.) arkasında çalıştırın.
CLIENT_IP_HEADER=

# Vercel Cron yetkilendirmesi (/api/cron). Üretmek: openssl rand -hex 32
CRON_SECRET=

# Doğrulama belgelerinin saklama süresi (gün). Süre sonunda belge silinir, sonuç kaydı kalır.
VERIFICATION_DOC_RETENTION_DAYS=30

# --- Yalnızca demo modu (Supabase yokken) ---
# Production derlemesinde (next start) demo modu için aşağıdaki DÖRT değer zorunludur;
# eksikse sunucu her isteği yapılandırma hatasıyla reddeder (bilinen varsayılanlar kullanılmaz).
ALLOW_DEMO_MODE=false
# Demo yönetici oturum çerezini imzalamak için (en az 32 karakter)
SESSION_SECRET=
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=
# Base32 TOTP sırrı (ör. `node -e "console.log(require('otpauth').Secret.fromHex(require('crypto').randomBytes(20).toString('hex')).base32)"`)
DEMO_ADMIN_TOTP_SECRET=
