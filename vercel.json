{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 3 * * *"
    }
  ],
  "framework": "nextjs",
  "buildCommand": "npm run build -- --webpack",
  "regions": [
    "fra1"
  ],
  "git": {
    "deploymentEnabled": {
      "feature/hilal-global-v2": false,
      "feature/hilal-global-platform": false
    }
  }
}
